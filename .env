# true  -> pakai mockClient (default, tanpa backend)
# false -> pakai httpClient ke API Python (FastAPI)
VITE_USE_MOCK=true

# Base URL API Python (dipakai hanya saat VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8000

# Mode Live (polling/WebSocket). Default false — komponen sudah siap tapi tidak aktif.
VITE_ENABLE_LIVE=false
